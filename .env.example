# Lito CRM â€” modelo de variÃ¡veis de ambiente.
# Copie para .env.local e preencha. NUNCA commite o .env.local.
# Ao criar uma variÃ¡vel nova, adicione aqui, no .env.local e na Vercel
# (production + preview + development).

# --- Supabase (Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<chave publishable/anon>"

# Service role â€” ignora RLS. SÃ“ no servidor, nunca com prefixo NEXT_PUBLIC_.
# Usada pelo motor de automaÃ§Ãµes (/api/automations/tick).
SUPABASE_SERVICE_ROLE_KEY="<chave service_role>"

# --- Motor de automaÃ§Ãµes ---
# Segredo do cabeÃ§alho x-automation-secret. String aleatÃ³ria de 32+ caracteres.
# O pg_cron envia esse valor ao chamar /api/automations/tick.
AUTOMATION_SECRET="<string aleatoria de 32+ caracteres>"

# --- E-mail transacional (Resend) ---
# DomÃ­nio news.litoaviation.com verificado no Resend (envia para qualquer destinatÃ¡rio).
RESEND_API_KEY="<chave do Resend>"
EMAIL_FROM="Lito CRM <nao-responder@news.litoaviation.com>"
# Reply-To dos transacionais (convites/automaÃ§Ãµes). NÃ£o precisa ser do domÃ­nio
# verificado â€” Ã© sÃ³ para onde vÃ£o as respostas. Ex.: contato@suaempresa.com
EMAIL_REPLY_TO="<e-mail para respostas (opcional)>"

# --- Email Marketing ---
# Segredo do webhook do Resend (Resend â†’ Webhooks â†’ o endpoint /api/marketing/resend-webhook).
# Verifica a assinatura Svix dos eventos de entrega/abertura/clique. Privada.
RESEND_WEBHOOK_SECRET="<signing secret do webhook do Resend>"

# --- App ---
# Local: http://localhost:3000 | ProduÃ§Ã£o: https://www.litocrm.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
