GOOGLE_ADS_API_VERSION=v25

# IA (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# TranscriÃ§Ã£o dos Ã¡udios das conversas (migraÃ§Ã£o 0081). Default whisper-1, que
# existe em qualquer conta; gpt-4o-mini-transcribe custa ~metade se a conta tiver.
OPENAI_TRANSCRIBE_MODEL=

# MÃ­dia Drive â€” Google Picker (aba Google Drive). PÃšBLICAS de propÃ³sito: o Picker
# roda no navegador. O client id Ã© o mesmo do Google Ads; a API key deve ser
# restrita por referenciador (HTTP referrers) no Google Cloud.
# No client OAuth, cadastre a ORIGEM JavaScript do CRM (nÃ£o URI de redirecionamento).
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
