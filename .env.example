WHATSAPP_GRAPH_VERSION=v21.0

# Google Ads (API oficial â€” Gerenciador de anÃºncios)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
