# Lito CRM — modelo de variáveis de ambiente.
# Copie para .env.local e preencha. NUNCA commite o .env.local.
# Ao criar uma variável nova, adicione aqui, no .env.local e na Vercel
# (production + preview + development).

# --- Supabase (Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<chave publishable/anon>"

# Service role — ignora RLS. SÓ no servidor, nunca com prefixo NEXT_PUBLIC_.
# Usada pelo motor de automações (/api/automations/tick).
SUPABASE_SERVICE_ROLE_KEY="<chave service_role>"

# --- Motor de automações ---
# Segredo do cabeçalho x-automation-secret. String aleatória de 32+ caracteres.
# O pg_cron envia esse valor ao chamar /api/automations/tick.
AUTOMATION_SECRET="<string aleatoria de 32+ caracteres>"

# --- E-mail transacional (Resend) ---
# Domínio news.litoaviation.com verificado no Resend (envia para qualquer destinatário).
RESEND_API_KEY="<chave do Resend>"
EMAIL_FROM="Lito CRM <nao-responder@news.litoaviation.com>"
# Reply-To dos transacionais (convites/automações). Não precisa ser do domínio
# verificado — é só para onde vão as respostas. Ex.: contato@suaempresa.com
EMAIL_REPLY_TO="<e-mail para respostas (opcional)>"

# --- Email Marketing ---
# Segredo do webhook do Resend (Resend → Webhooks → o endpoint /api/marketing/resend-webhook).
# Verifica a assinatura Svix dos eventos de entrega/abertura/clique. Privada.
RESEND_WEBHOOK_SECRET="<signing secret do webhook do Resend>"

# --- App ---
# Local: http://localhost:3000 | Produção: https://lito-crm.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0

# Google Ads (API oficial — Gerenciador de anúncios)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=v25

# IA (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mídia Drive — Canva (Connect API). O Google Drive reusa GOOGLE_OAUTH_CLIENT_ID/SECRET
# acima, com o escopo drive.readonly; só é preciso liberar a Drive API no projeto
# do Google Cloud e cadastrar o redirect /api/media/oauth/callback.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Mídia Drive — Google Picker (aba Google Drive). PÚBLICAS de propósito: o Picker
# roda no navegador. O client id é o mesmo do Google Ads; a API key deve ser
# restrita por referenciador (HTTP referrers) no Google Cloud.
# No client OAuth, cadastre a ORIGEM JavaScript do CRM (não URI de redirecionamento).
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# PREFIRA ESTAS DUAS às NEXT_PUBLIC_ acima: são lidas no servidor
# (/api/media/google-config) e valem na requisição seguinte. As NEXT_PUBLIC_
# ficam embutidas no build, então mudá-las na Vercel só tem efeito depois de um
# novo deploy — o que já fez a aba Mídia dizer "falta configurar" com as
# variáveis definidas. Continuam funcionando; a precedência é NEXT_PUBLIC_ > estas.
# GOOGLE_PICKER_CLIENT_ID só é necessário se o Picker usar um client OAuth
# diferente do GOOGLE_OAUTH_CLIENT_ID (do Google Ads) — o do Picker precisa ter
# a ORIGEM JavaScript cadastrada, coisa que o do Ads normalmente não tem.
GOOGLE_PICKER_CLIENT_ID=
GOOGLE_API_KEY=
